// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  emoji     String    @default("📦")
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id          String      @id @default(cuid())
  name        String
  description String      @default("")
  price       Float
  unit        String      @default("יחידה")
  imageEmoji  String      @default("🛍️")
  inStock     Boolean     @default(true)
  stockQty    Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String   @unique
  address   String   @default("")
  notes     String   @default("")
  orders    Order[]
  createdAt DateTime @default(now())
}

model Order {
  id          String      @id @default(cuid())
  orderNumber Int         @unique
  customerId  String
  customer    Customer    @relation(fields: [customerId], references: [id])
  items       OrderItem[]
  total       Float
  status      String      @default("new") // new | confirmed | packed | delivered | cancelled
  deliveryType String     @default("pickup") // pickup | delivery
  address     String      @default("")
  notes       String      @default("")
  waMessage   String      @default("")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
}

model StoreSettings {
  id            String  @id @default("singleton")
  storeName     String  @default("החנות שלי")
  whatsappPhone String  @default("972500000000")
  adminPassword String  @default("admin123")
  welcomeText   String  @default("ברוכים הבאים! 🛍️ מה תרצו להזמין היום?")
}
